{
  "/v1/products/{namespace_id}/create": {
    "post": {
      "tags": [
        "Products"
      ],
      "summary": "Create Product",
      "description": "Manually create a new product under the specified namespace.\n\nAccepts product metadata as form parameters and an optional list of up to 3 asset files.\nTriggers an asynchronous background job to generate and index vectors for the product.\n```\n    ALLOWED_IMAGE_TYPES = {\"image/jpeg\", \"image/png\", \"image/webp\"}\n    ALLOWED_VIDEO_TYPES = {\"video/mp4\"}\n    ALLOWED_FILE_TYPES = {\"application/pdf\"}\n    MAX_PRODUCT_ASSETS = 3\n    MAX_IMAGE_SIZE = 5MB\n    MAX_VIDEO_SIZE = 25MB\n    MAX_FILE_SIZE = 10MB\n    MAX_CSV_SIZE = 5MB\n\n```",
      "operationId": "create_product_v1_products__namespace_id__create_post",
      "parameters": [
        {
          "name": "namespace_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid",
            "title": "Namespace Id"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "$ref": "#/components/schemas/Body_create_product_v1_products__namespace_id__create_post"
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Successful Response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductDetailResponse"
              }
            }
          }
        },
        "422": {
          "description": "Validation Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          }
        }
      }
    }
  },
  "/v1/products/{namespace_id}/all-products": {
    "get": {
      "tags": [
        "Products"
      ],
      "summary": "Get Products",
      "description": "Retrieve a cursor-paginated list of products for the given namespace.\n\nReturns basic product details along with up to three primary assets per product.",
      "operationId": "get_products_v1_products__namespace_id__all_products_get",
      "parameters": [
        {
          "name": "namespace_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid",
            "title": "Namespace Id"
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "schema": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cursor for pagination",
            "title": "Cursor"
          },
          "description": "Cursor for pagination"
        },
        {
          "name": "page_size",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "maximum": 100,
            "minimum": 1,
            "description": "Items per page",
            "default": 20,
            "title": "Page Size"
          },
          "description": "Items per page"
        }
      ],
      "responses": {
        "200": {
          "description": "Successful Response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductListResponse"
              }
            }
          }
        },
        "422": {
          "description": "Validation Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          }
        }
      }
    }
  },
